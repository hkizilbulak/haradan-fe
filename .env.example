# Haradan FE — kopyalayıp `.env` yapın.
# BE OpenAPI server: /api  (HTTP_ADDR varsayılan :8080)

EXPO_PUBLIC_API_URL=http://localhost:8080/api

# BE tarafında tarayıcı origin'i açın. Development'ta BE loopback
# (localhost / 127.0.0.1 / [::1], herhangi bir port) otomatik izinlidir.
# Production: tam origin listesi, örn. https://haradan.com
# CORS_ALLOWED_ORIGINS=https://haradan.com

# Auth varsayılan: URL varsa gerçek BE.
# Mock’a zorlamak için:
# EXPO_PUBLIC_USE_MOCK_AUTH=1
