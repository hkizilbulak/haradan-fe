# Haradan FE — kopyalayıp `.env` yapın.
# BE OpenAPI server: /api  (HTTP_ADDR varsayılan :8080)

EXPO_PUBLIC_API_URL=http://localhost:8080/api

# --- Railway (production) ---
# Exact value (no /v1, no trailing dots):
# EXPO_PUBLIC_API_URL=https://haradan-be-production.up.railway.app/api
# PORT              → Railway verir; Target Port: 8080
# HOST=0.0.0.0
#
# Mock flag'leri production'da tanımlamayın.
# BE CORS_ALLOWED_ORIGINS'e FE origin'ini ekleyin (generate domain sonrası):
# CORS_ALLOWED_ORIGINS=https://<fe-service>.up.railway.app

# BE tarafında tarayıcı origin'i açın. Development'ta BE loopback
# (localhost / 127.0.0.1 / [::1], herhangi bir port) otomatik izinlidir.
# Production: tam origin listesi, örn. https://haradan.com
# CORS_ALLOWED_ORIGINS=https://haradan.com

# Auth varsayılan: URL varsa gerçek BE.
# Mock’a zorlamak için:
# EXPO_PUBLIC_USE_MOCK_AUTH=1

# Listing / TJK / media / katalog / konum / ilanlarım / ilan detay da URL varsa HTTP.
# Konum listesi BE üzerinden canlı Türkiye il/ilçe kataloğundan gelir;
# seçilen ilçe ilan kaydına yazılır.
# Tek tek mock:
# EXPO_PUBLIC_USE_MOCK_API=1
# EXPO_PUBLIC_USE_MOCK_TJK=1
# EXPO_PUBLIC_USE_MOCK_LISTING=1
# EXPO_PUBLIC_USE_MOCK_MEDIA=1
# EXPO_PUBLIC_USE_MOCK_CATALOG=1
# EXPO_PUBLIC_USE_MOCK_GEO=1
# EXPO_PUBLIC_USE_MOCK_MY_LISTINGS=1
# EXPO_PUBLIC_USE_MOCK_ADVERT=1
# EXPO_PUBLIC_USE_MOCK_ADVERTS_SEARCH=1
# EXPO_PUBLIC_USE_MOCK_HOMEPAGE=1
# EXPO_PUBLIC_USE_MOCK_FAVORITES=1
